region      = "us-east-1"
project_name = "marketing-site"
environment = "prod"

domain_name             = "example.com"
alternate_domain_names  = ["www.example.com"]
acm_certificate_arn     = "arn:aws:acm:us-east-1:123456789012:certificate/abcd1234-abcd-1234-abcd-1234abcd1234"
create_hosted_zone      = true
hosted_zone_comment     = "Managed by Terraform"
hosted_zone_id          = ""
create_www_record       = true

site_bucket_name       = "example-com-frontend"
s3_force_destroy       = false
s3_enable_versioning   = true

default_root_object    = "index.html"
price_class            = "PriceClass_100"
compress_objects       = true
geo_restriction_type   = "none"
geo_restriction_locations = []

enable_cloudfront_logging   = false
logging_bucket_domain_name  = ""
logging_prefix              = "cloudfront/"

tags = {
  Owner = "platform-team"
}
